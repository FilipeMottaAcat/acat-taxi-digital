# Postgres connection string (Neon in production, local Postgres in dev)
DATABASE_URL="postgresql://user:password@localhost:5432/acat_taxi?schema=public"

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me"

PORT=3001
NODE_ENV=development

# Web Push (VAPID) — generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@acattaxidigital.com.br"
